<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_info_window_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/info_window_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Адрес улицы"
        android:textColor="#0F1E4F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/info_window_snippet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Информация о поездке"
        android:textColor="#FF7F00"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_car_marker_info"
        app:drawableTint="#FF7F00" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardElevation="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_language_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"/>

        <RadioGroup
            android:id="@+id/rg_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_lang_ua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_ukrainian"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                android:layoutDirection="rtl"
                android:textAlignment="textStart"/>

            <RadioButton
                android:id="@+id/rb_lang_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_english"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                android:layoutDirection="rtl"
                android:textAlignment="textStart"
                android:layout_marginTop="8dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btn_save_language"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#454754"
            android:background="@drawable/bg_button_yellow"
            app:backgroundTint="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
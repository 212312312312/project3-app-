<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_top_rounded"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="#E0E0E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Оберіть час подачі"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_search_input"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tab_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Дата"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@color/text_primary"
            android:textColor="@color/card_background" />
        <TextView
            android:id="@+id/tab_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Час"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@null"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:id="@+id/date_picker_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleX="1.2"
            android:scaleY="1.2">

            <NumberPicker
                android:id="@+id/date_picker_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/time_picker_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleX="1.2"
            android:scaleY="1.2"
            android:visibility="gone">

            <TimePicker
                android:id="@+id/time_picker_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                android:theme="@style/CustomPickerTheme" />
        </FrameLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btn_confirm_schedule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Підтвердити"
        android:background="@drawable/bg_button_yellow"
        android:textColor="@color/black"
        android:textStyle="bold" />

</LinearLayout>
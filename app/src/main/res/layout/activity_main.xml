<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_background"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- === ЕКРАН 1: СТАНДАРТНИЙ ВХІД ТА GOOGLE === -->
    <LinearLayout
        android:id="@+id/layout_phone_input"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textColor="?attr/colorOnBackground"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_phone_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+380"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DDDDDD"/>

            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/phone_hint"
                android:textColorHint="@color/text_secondary"
                android:inputType="phone"
                android:paddingStart="12dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Нова кнопка: Продовжити -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_yellow">

            <Button
                android:id="@+id/btn_get_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_continue"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#454754"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Нова кнопка: Продовжити з Google -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_secondary">

            <!-- Іконка Google зліва -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/ic_google"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Текст рівно по центру -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Продовжити з Google"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#757575"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Прозора кнопка поверх усього (щоб в Kotlin не міняти логіку кліків) -->
            <Button
                android:id="@+id/btn_google_sign_in"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_privacy_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/privacy_disclaimer"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>

    <!-- === ЕКРАН 2: ВВЕДЕННЯ СМС КОДУ === -->
    <LinearLayout
        android:id="@+id/layout_sms_verify"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sms_verify_title"
            android:textColor="?attr/colorOnBackground"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sms_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sms_verify_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:weightSum="6"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="6dp">
            <EditText style="@style/OtpBox" android:id="@+id/otp_1"/>
            <Space android:layout_width="8dp" android:layout_height="match_parent"/>
            <EditText style="@style/OtpBox" android:id="@+id/otp_2"/>
            <Space android:layout_width="8dp" android:layout_height="match_parent"/>
            <EditText style="@style/OtpBox" android:id="@+id/otp_3"/>
            <Space android:layout_width="8dp" android:layout_height="match_parent"/>
            <EditText style="@style/OtpBox" android:id="@+id/otp_4"/>
            <Space android:layout_width="8dp" android:layout_height="match_parent"/>
            <EditText style="@style/OtpBox" android:id="@+id/otp_5"/>
            <Space android:layout_width="8dp" android:layout_height="match_parent"/>
            <EditText style="@style/OtpBox" android:id="@+id/otp_6"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_resend_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/sms_resend_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:clickable="false"
            android:focusable="true"
            android:background="@android:color/transparent"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Нова кнопка: Ввійти (Перевірка СМС) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_yellow">

            <Button
                android:id="@+id/btn_verify"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/btn_login"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#454754"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- === ЕКРАН 3: ПРИВ'ЯЗКА НОМЕРА (ПІСЛЯ GOOGLE) === -->
    <LinearLayout
        android:id="@+id/layout_link_phone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Майже готово!"
            android:textColor="?attr/colorOnBackground"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Для безпеки та зв'язку з водієм додайте номер телефону."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_phone_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+380"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DDDDDD"/>

            <EditText
                android:id="@+id/et_link_phone_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/phone_hint"
                android:textColorHint="@color/text_secondary"
                android:inputType="phone"
                android:autofillHints="phone"
                android:paddingStart="12dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Нова кнопка: Підтвердити привязку -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_yellow">

            <Button
                android:id="@+id/btn_link_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Підтвердити"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#454754"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- === TOAST ПОВІДОМЛЕННЯ === -->
    <androidx.cardview.widget.CardView
        android:id="@+id/custom_toast_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="60dp"

        app:cardBackgroundColor="@color/toast_background"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp"

        android:outlineSpotShadowColor="@color/toast_shadow"
        android:outlineAmbientShadowColor="@color/toast_shadow"
        tools:targetApi="p"

        android:visibility="invisible"
        android:translationY="-200dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="28dp"
            android:minWidth="200dp">

            <ImageView
                android:id="@+id/iv_toast_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alert_circle"
                app:tint="@color/taxi_yellow"/>

            <TextView
                android:id="@+id/tv_toast_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/toast_default_message"
                android:textColor="@color/toast_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxWidth="300dp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
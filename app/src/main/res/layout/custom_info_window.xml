<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/info_window_bg"
    app:cardCornerRadius="8dp" 
    app:cardElevation="4dp"
    app:contentPadding="8dp"> <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minWidth="140dp"> <TextView
            android:id="@+id/info_window_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ТОЧКА А"
            android:textColor="@color/info_window_text"
            android:textSize="10sp" 
            android:textStyle="bold"
            android:textAllCaps="true"
            android:alpha="0.7"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/info_window_snippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вулиця..."
            android:textColor="@color/info_window_text"
            android:textSize="13sp" 
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:maxWidth="200dp"/> <LinearLayout
            android:id="@+id/info_window_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp" 
                android:layout_height="12dp"
                android:src="@drawable/ic_car_marker_info"
                app:tint="@color/taxi_yellow"/>

            <TextView
                android:id="@+id/info_window_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.5 км"
                android:textSize="12sp" 
                android:textColor="@color/taxi_yellow"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
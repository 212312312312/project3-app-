<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/unified_block_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_rating_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оцініть поїздку"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <RatingBar
            android:id="@+id/rating_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="0"
            android:isIndicator="false"
            android:clickable="true"
            android:focusable="true"
            style="?android:attr/ratingBarStyle"
            android:theme="@style/RatingBarNoRipple"
            android:progressTint="@color/taxi_yellow"
            android:progressBackgroundTint="#808080"
            android:secondaryProgressTint="@android:color/transparent"
            android:background="@android:color/transparent"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ваш коментар (необов'язково)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/menu_background_color"
            android:padding="12dp"
            android:minHeight="80dp"
            android:gravity="top|start"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_submit_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Відправити"
            android:background="@drawable/bg_button_yellow"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>